# Supabase Postgres — Project Settings > Database > Connect
# DATABASE_URL: Transaction Pooler (port 6543). Append ?pgbouncer=true to the
# connection string Supabase gives you. Used by the app at runtime (lib/prisma.ts).
# DIRECT_URL:   "Session pooler" or direct connection string (port 5432) — used by the Prisma CLI (generate/migrate), see prisma.config.ts
DATABASE_URL=""
DIRECT_URL=""


# Public base URL of this deployment (used to build Pesapal callback/IPN URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storefront kill-switch for the soft launch. "false" (or unset) = brand/teaser
# site: shop, cart, and checkout routes redirect to home. "true" = full storefront.
# NOTE: NEXT_PUBLIC_* is inlined at build time — changing this needs a rebuild
# (docker build --build-arg NEXT_PUBLIC_SHOP_LIVE=true ...).
NEXT_PUBLIC_SHOP_LIVE=true
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Auth.js
AUTH_SECRET=
# Canonical URL of this deployment, e.g. http://localhost:3000 or https://deperfumeshop.co.ke
AUTH_URL=
# OAuth is optional. Leave blank to run on email/password only (the seeded admin).
# Set NEXT_PUBLIC_OAUTH_ENABLED=true once these are filled to show the sign-in buttons.
# NEXT_PUBLIC_* is inlined at build time — rebuild the image after changing it.
# Google redirect URI to register in Cloud Console: <AUTH_URL>/api/auth/callback/google
NEXT_PUBLIC_OAUTH_ENABLED=false
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# WhatsApp checkout
# Digits only, country code, no + or spaces, e.g. 254712345678
NEXT_PUBLIC_WHATSAPP_NUMBER=

# pesapal
# During the soft launch (NEXT_PUBLIC_SHOP_LIVE=false) checkout is disabled and
# nothing calls Pesapal, so sandbox values below are fine. For the commerce launch:
# set live consumer key/secret, PESAPAL_BASE_URL=https://pay.pesapal.com/v3, then
# run `pnpm pesapal:register-ipn` to obtain PESAPAL_IPN_ID.
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=

PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3

# Populated by running `scripts/register-pesapal-ipn.ts` once per environment
# (registers the IPN callback URL with Pesapal and returns this id)
PESAPAL_IPN_ID=

# Redis (caching, rate limiting, tokens, idempotency, distributed locks)
# Local dev: docker compose up -d
REDIS_URL=redis://localhost:6379

# RabbitMQ (async order/notification/invoice jobs)
# Local dev: docker compose up -d
RABBITMQ_URL=amqp://localhost:5672

# Resend (transactional email — newsletter welcome, contact form, order emails)
RESEND_API_KEY=re_xxxxxxxxx
# Must be a verified sending domain in Resend, e.g. hello@deperfumeshop.co.ke
RESEND_FROM_EMAIL="ci@example.com"
# Inbox that receives contact-form messages and new-order notifications
ADMIN_NOTIFICATION_EMAIL="ci@example.com"

# ------------------------------------------------------------------
# Deployment (docker-compose on a VPS) — not read by the Next.js app
# ------------------------------------------------------------------
# Domain Caddy serves + terminates TLS for, e.g. deperfumeshop.co.ke
SITE_ADDRESS=
# Email Let's Encrypt uses for expiry notices
ACME_EMAIL=
# Docker Hub account the published images live under (see docker-publish.yml).
# Leave as "local" to build images on the box instead of pulling.
DOCKERHUB_USERNAME=local
# Image tag to run — "latest" or a short commit SHA
IMAGE_TAG=latest
