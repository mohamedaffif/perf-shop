# Supabase Postgres connection string (Project Settings > Database > Connection string > URI)
DATABASE_URL=

# Public base URL of this deployment (used to build Pesapal callback/IPN URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Auth.js
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# WhatsApp checkout
# Digits only, country code, no + or spaces, e.g. 254712345678
NEXT_PUBLIC_WHATSAPP_NUMBER=

# pesapal
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=

PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3

# Populated by running `scripts/register-pesapal-ipn.ts` once per environment
# (registers the IPN callback URL with Pesapal and returns this id)
PESAPAL_IPN_ID=

# Redis (caching, rate limiting, tokens, idempotency, distributed locks)
# Local dev: docker compose up -d
REDIS_URL=redis://localhost:6379

# RabbitMQ (async order/notification/invoice jobs)
# Local dev: docker compose up -d
RABBITMQ_URL=amqp://localhost:5672

# Resend (transactional email)
RESEND_API_KEY=re_xxxxxxxxx
# Must be a verified sending domain in Resend, e.g. orders@deperfumeshop.com
RESEND_FROM_EMAIL="ci@example.com"
# Inbox that receives new-order notifications
ADMIN_NOTIFICATION_EMAIL="ci@example.com"
