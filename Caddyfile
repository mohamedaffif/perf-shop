# Reverse proxy + automatic HTTPS for the DE PERFUME SHOP app container.
# SITE_ADDRESS and ACME_EMAIL are provided by docker-compose from .env.
{
	email {$ACME_EMAIL:dev@localhost}

	# Real client IP behind Cloudflare. Only requests arriving from Cloudflare's
	# published ranges may set the client IP (via CF-Connecting-IP); anyone else
	# is identified by their own socket address, so the header can't be spoofed
	# by hitting the origin directly. Before the Cloudflare cutover no request
	# comes from these ranges, so the socket address is used — also correct.
	# Source: https://www.cloudflare.com/ips-v4 and /ips-v6 (fetched 2026-09-26).
	# Keep in sync with the ufw allowlist (scaling plan, Phase 8 step 6).
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Let the app set its own security headers (see next.config.ts); just make
	# sure upstream never leaks a Server banner.
	header -Server

	# Two Next.js replicas (docker-compose app1/app2). least_conn favours the
	# less busy one; active health checks drop a replica that stops answering
	# /api/health (liveness only), and lb_try_duration retries on the other
	# replica while one restarts during a deploy.
	reverse_proxy app1:3000 app2:3000 {
		lb_policy least_conn
		lb_try_duration 5s
		health_uri /api/health
		health_interval 10s
		health_timeout 3s

		# The one header the app trusts for the client IP (lib/rate-limit.ts).
		# Always overwritten here, so a client-supplied X-Real-IP never survives.
		header_up X-Real-IP {client_ip}
	}
}
